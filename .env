DB_URL=https://db.babel-revolution.fr
IA_SERVER_URL=http://iaserver:8000

# used for public access (like realtime or admin actions)
PUBLIC_DB_URL=https://db.babel-revolution.fr

# Backend du classifieur scripted (cf. docs/narrative-engine-design.md §6 / Phase 6-7).
# Valeurs côté SvelteKit (privé) :
#   `stub` (défaut)  : classifieur TS local
#   `word2vec`        : appel /api/classify Go, backend cosine similarity
#   `llm`             : appel /api/classify Go, backend Mistral (Phase 7)
# IA_CLASSIFY_BACKEND=stub
#
# Côté serveur Go (cf. ia_server/, exposé via docker-compose) :
#   CLASSIFY_BACKEND=word2vec  # `word2vec` (défaut) | `llm`. Switch interne au handler.
#   MISTRAL_API_KEY=...         # requis si CLASSIFY_BACKEND=llm. Sinon fallback word2vec.
#   MISTRAL_MODEL=mistral-small-latest  # optionnel, défaut latence/coût minimaux.
#   MISTRAL_API_URL=             # optionnel, override l'endpoint (utile pour tests).
